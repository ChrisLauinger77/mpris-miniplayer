#: src/window.vala:289 src/window.vala:494 src/window.vala:721
msgid "Queue"
msgstr "Warteschlange"

#: src/status-indicator.vala:637 src/window.vala:569
msgid "Queue is empty"
msgstr "Warteschlange ist leer"

#: src/status-indicator.vala:639
#, c-format
msgid "Volume: %s%%"
msgstr "Lautstärke: %s%%"

#: src/status-indicator.vala:642 src/window.vala:400 src/window.vala:1164
msgid "Mute"
msgstr "Stummschalten"

#: src/status-indicator.vala:643 src/window.vala:1160
msgid "Restore volume"
msgstr "Lautstärke wiederherstellen"

#: src/status-indicator.vala:645 src/window.vala:760
msgid "Compact Mode"
msgstr "Kompakter Modus"

