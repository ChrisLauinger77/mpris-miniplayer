msgstr "Zurück"

#: src/status-indicator.vala:464
msgid "Pause"
msgstr "Pause"

#: src/status-indicator.vala:465
msgid "Play"
msgstr "Wiedergabe"

#: src/status-indicator.vala:467 src/window.vala:270
msgid "Next"
msgstr "Weiter"

#: src/status-indicator.vala:469
#, c-format
msgid "Volume: %d%%"
msgstr "Lautstärke: %d%%"

#: src/status-indicator.vala:472 src/window.vala:1053
msgid "Mute"
msgstr "Stummschalten"

#: src/status-indicator.vala:473 src/window.vala:1049
msgid "Restore volume"
msgstr "Lautstärke wiederherstellen"

#: src/status-indicator.vala:483 src/window.vala:147
msgid "Compact Mode"
msgstr "Kompakter Modus"

