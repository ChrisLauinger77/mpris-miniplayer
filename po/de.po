msgid "MPRIS MiniPlayer"
msgstr "MPRIS MiniPlayer"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.desktop.in:3
#: data/io.github.ChrisLauinger.MprisMiniPlayer.metainfo.xml.in:7
msgid "Control MPRIS-compatible media players"
msgstr "MPRIS-kompatible Medienspieler steuern"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.desktop.in:13
#: src/status-indicator.vala:621 src/window.vala:459 src/window.vala:667
msgid "Play"
msgstr "Wiedergabe"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.desktop.in:18
#: src/status-indicator.vala:620 src/window.vala:664
msgid "Pause"
msgstr "Pause"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.desktop.in:23
#: src/status-indicator.vala:617 src/window.vala:450
msgid "Previous"
msgstr "Zurück"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.desktop.in:28
#: src/status-indicator.vala:623 src/window.vala:469
msgid "Next"
msgstr "Weiter"

#: data/io.github.ChrisLauinger.MprisMiniPlayer.metainfo.xml.in:9
msgid ""
"MPRIS MiniPlayer is a small GTK mini player for Linux media players that "
"expose the MPRIS interface on the session bus."
msgstr ""
"MPRIS MiniPlayer ist ein kleiner GTK-Mini-Player für Linux-Medienspieler, "
"die die MPRIS-Schnittstelle auf dem Sitzungsbus bereitstellen."

#: data/io.github.ChrisLauinger.MprisMiniPlayer.metainfo.xml.in:16
msgid "Christian Lauinger"
msgstr "Christian Lauinger"

#: src/background-portal.vala:96 src/background-portal.vala:214
msgid "Monitoring media players"
msgstr "Medienspieler überwachen"

#: src/background-portal.vala:140
msgid "Keep watching for MPRIS-compatible media players"
msgstr "Weiter nach MPRIS-kompatiblen Medienspielern suchen"

#: src/status-indicator.vala:603
msgid "Show MPRIS MiniPlayer"
msgstr "MPRIS MiniPlayer anzeigen"

#: src/status-indicator.vala:605
msgid "Hide MPRIS MiniPlayer"
msgstr "MPRIS MiniPlayer ausblenden"

#: src/status-indicator.vala:607 src/window.vala:763
#, c-format
msgid "Update available: %s"
msgstr "Aktualisierung verfügbar: %s"

#: src/status-indicator.vala:615 src/window.vala:602
msgid "No player detected"
msgstr "Kein Medienspieler erkannt"

#: src/status-indicator.vala:625 src/window.vala:446
msgid "Shuffle"
msgstr "Zufallswiedergabe"

#: src/status-indicator.vala:629
msgid "Off"
msgstr "Aus"

#: src/status-indicator.vala:631
msgid "Current Track"
msgstr "Aktueller Titel"

