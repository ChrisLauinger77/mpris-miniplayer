msgstr "Wiederholen: Aus"

#: src/status-indicator.vala:871 src/window.vala:499
msgid "Repeat: Current Track"
msgstr "Wiederholen: Aktueller Titel"

#: src/status-indicator.vala:873 src/window.vala:502
