msgid "About"
msgstr "Info"

#: src/status-indicator.vala:651 src/window.vala:770
msgid "Quit"
msgstr "Beenden"

#: src/status-indicator.vala:958 src/window.vala:481 src/window.vala:709
msgid "Repeat: Off"
msgstr "Wiederholen: Aus"

#: src/status-indicator.vala:961 src/window.vala:712
msgid "Repeat: Current Track"
msgstr "Wiederholen: Aktueller Titel"

#: src/status-indicator.vala:963 src/window.vala:715
msgid "Repeat: Queue"
msgstr "Wiederholen: Warteschlange"

#: src/status-indicator.vala:983 src/window.vala:841
#, c-format
msgid "%s — %s"
msgstr "%s — %s"

#: src/application.vala:40
msgid "Control playback"
msgstr "Wiedergabe steuern"

#: src/application.vala:47
msgid "Unexpected command-line arguments.\n"
msgstr "Unerwartete Befehlszeilenargumente.\n"

#: src/application.vala:55
#, c-format
msgid "Unknown playback action “%s”.\n"
msgstr "Unbekannte Wiedergabeaktion „%s“.\n"

#: src/application.vala:641
msgid "MPRIS MiniPlayer is running in the background"
msgstr "MPRIS MiniPlayer läuft im Hintergrund"

#: src/application.vala:643
msgid ""
"The window will appear automatically when a compatible media player becomes "
"available."
msgstr ""
"Das Fenster erscheint automatisch, sobald ein kompatibler Medienspieler "
"verfügbar ist."

#: src/application.vala:645
msgid "Open the window when you want to control a compatible media player."
msgstr ""
"Öffne das Fenster, wenn du einen kompatiblen Medienspieler steuern möchtest."

#: src/application.vala:647
msgid "Open"
msgstr "Öffnen"

#: src/preferences-window.vala:37
msgid "Behavior"
msgstr "Verhalten"

#: src/preferences-window.vala:41
msgid "Show and hide automatically"
msgstr "Automatisch anzeigen und ausblenden"

#: src/preferences-window.vala:42
msgid "Show the window when a player appears and hide it when none remain"
msgstr ""
"Das Fenster anzeigen, wenn ein Medienspieler erscheint, und ausblenden, wenn "
"keiner mehr verfügbar ist"

#: src/preferences-window.vala:50
msgid "Background notification"
msgstr "Hintergrundbenachrichtigung"

#: src/preferences-window.vala:51
msgid "Notify when the app starts hidden in the background"
msgstr "Benachrichtigen, wenn die App versteckt im Hintergrund startet"

#: src/preferences-window.vala:59
msgid "Start on login"
msgstr "Bei Anmeldung starten"

#: src/preferences-window.vala:60
msgid "Start MPRIS MiniPlayer automatically when you log in"
msgstr "MPRIS MiniPlayer automatisch starten, wenn du dich anmeldest"

#: src/preferences-window.vala:70
msgid "Compact mode"
msgstr "Kompakter Modus"

#: src/preferences-window.vala:71
msgid "Use a smaller window layout"
msgstr "Ein kleineres Fensterlayout verwenden"

#: src/preferences-window.vala:79
msgid "Tint with album color"
msgstr "Mit Albumfarbe einfärben"

#: src/preferences-window.vala:80
msgid "Use a color from the current album cover"
msgstr "Eine Farbe des aktuellen Albumcovers verwenden"

#: src/preferences-window.vala:88
msgid "Keep player queue open"
msgstr "Player-Queue geöffnet lassen"

#: src/preferences-window.vala:89
msgid "Keep the queue in the player window open after selecting a track"
msgstr "Die Queue im Player-Fenster nach der Titelauswahl geöffnet lassen"

#: src/preferences-window.vala:97
msgid "Status indicator"
msgstr "Statusanzeige"

#: src/preferences-window.vala:123
msgid "Show an indicator when the app is running"
msgstr "Eine Anzeige zeigen, wenn die Anwendung läuft"

#: src/preferences-window.vala:124
msgid "Not supported by this desktop"
msgstr "Von diesem Desktop nicht unterstützt"

#: src/window.vala:33
msgid "Currently playing"
msgstr "Wird gerade wiedergegeben"

#: src/window.vala:266
msgid "Choose player"
msgstr "Medienspieler auswählen"

#: src/window.vala:278
msgid "Main menu"
msgstr "Hauptmenü"

#: src/window.vala:283
msgid "About MPRIS MiniPlayer"
msgstr "Info zu MPRIS MiniPlayer"

#: src/window.vala:322
msgid "No player running"
msgstr "Kein Medienspieler läuft"

#: src/window.vala:328
msgid "Start an MPRIS-compatible media player"
msgstr "Starte einen MPRIS-kompatiblen Medienspieler"

#: src/window.vala:346 src/window.vala:349
msgid "Playback position"
msgstr "Wiedergabeposition"

#: src/window.vala:411 src/window.vala:412
msgid "Volume"
msgstr "Lautstärke"

#: src/window.vala:593
msgid "Session D-Bus unavailable"
msgstr "Sitzungs-D-Bus nicht verfügbar"

#: src/window.vala:593 src/window.vala:608
msgid "Unable to monitor MPRIS players"
msgstr "MPRIS-Medienspieler können nicht überwacht werden"

#: src/window.vala:602
msgid "Start any MPRIS-compatible player"
msgstr "Starte einen MPRIS-kompatiblen Medienspieler"

#: src/window.vala:608
msgid "Player unavailable"
msgstr "Medienspieler nicht verfügbar"

#: src/window.vala:702
msgid "Shuffle: On"
msgstr "Zufallswiedergabe: An"

#: src/window.vala:702
msgid "Shuffle: Off"
msgstr "Zufallswiedergabe: Aus"

#: src/window.vala:721
msgid "Queue unavailable"
msgstr "Warteschlange nicht verfügbar"

#: src/window.vala:838 src/mpris-player.vala:664 src/mpris-player.vala:820
msgid "Unknown artist"
msgstr "Unbekannter Künstler"

#: src/mpris-player.vala:657 src/mpris-player.vala:819
msgid "Unknown track"
msgstr "Unbekannter Titel"

