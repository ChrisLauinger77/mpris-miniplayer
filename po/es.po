msgstr "Argumentos de línea de órdenes inesperados.\n"

#: src/application.vala:55
#, c-format
msgid "Unknown playback action “%s”.\n"
msgstr "Acción de reproducción desconocida «%s».\n"

#: src/application.vala:641
msgid "MPRIS MiniPlayer is running in the background"
msgstr "MPRIS MiniPlayer se está ejecutando en segundo plano"

#: src/application.vala:643
msgid ""
"The window will appear automatically when a compatible media player becomes "
"available."
msgstr ""
"La ventana aparecerá automáticamente cuando haya disponible un reproductor "
"multimedia compatible."

#: src/application.vala:645
msgid "Open the window when you want to control a compatible media player."
msgstr ""
"Abre la ventana cuando quieras controlar un reproductor multimedia "
"compatible."

#: src/application.vala:647
msgid "Open"
msgstr "Abrir"

#: src/preferences-window.vala:37
msgid "Behavior"
msgstr "Comportamiento"

#: src/preferences-window.vala:41
msgid "Show and hide automatically"
msgstr "Mostrar y ocultar automáticamente"

#: src/preferences-window.vala:42
msgid "Show the window when a player appears and hide it when none remain"
msgstr ""
"Mostrar la ventana cuando aparezca un reproductor y ocultarla cuando no "
"quede ninguno"

#: src/preferences-window.vala:50
msgid "Background notification"
msgstr "Notificación en segundo plano"

#: src/preferences-window.vala:51
msgid "Notify when the app starts hidden in the background"
msgstr "Notificar cuando la aplicación se inicia oculta en segundo plano"

#: src/preferences-window.vala:59
msgid "Start on login"
msgstr "Iniciar al iniciar sesión"

#: src/preferences-window.vala:60
msgid "Start MPRIS MiniPlayer automatically when you log in"
msgstr "Iniciar MPRIS MiniPlayer automáticamente cuando inicies sesión"

#: src/preferences-window.vala:70
msgid "Compact mode"
msgstr "Modo compacto"

#: src/preferences-window.vala:71
msgid "Use a smaller window layout"
msgstr "Usar una disposición de ventana más pequeña"

#: src/preferences-window.vala:79
msgid "Tint with album color"
msgstr "Teñir con el color del álbum"

#: src/preferences-window.vala:80
msgid "Use a color from the current album cover"
msgstr "Usar un color de la portada del álbum actual"

#: src/preferences-window.vala:88
msgid "Keep player queue open"
msgstr "Mantener abierta la cola del reproductor"

#: src/preferences-window.vala:89
msgid "Keep the queue in the player window open after selecting a track"
msgstr ""
"Mantener abierta la cola en la ventana del reproductor después de "
"seleccionar una pista"

#: src/preferences-window.vala:97
msgid "Status indicator"
msgstr "Indicador de estado"

#: src/preferences-window.vala:123
msgid "Show an indicator when the app is running"
msgstr "Mostrar un indicador cuando la aplicación esté en ejecución"

#: src/preferences-window.vala:124
msgid "Not supported by this desktop"
msgstr "No compatible con este escritorio"

#: src/window.vala:33
msgid "Currently playing"
msgstr "Reproduciendo"

#: src/window.vala:266
msgid "Choose player"
msgstr "Elegir reproductor"

#: src/window.vala:278
msgid "Main menu"
msgstr "Menú principal"

#: src/window.vala:283
msgid "About MPRIS MiniPlayer"
msgstr "Acerca de MPRIS MiniPlayer"

#: src/window.vala:322
msgid "No player running"
msgstr "No hay ningún reproductor en ejecución"

#: src/window.vala:328
msgid "Start an MPRIS-compatible media player"
msgstr "Inicia un reproductor multimedia compatible con MPRIS"

#: src/window.vala:346 src/window.vala:349
msgid "Playback position"
msgstr "Posición de reproducción"

#: src/window.vala:411 src/window.vala:412
msgid "Volume"
msgstr "Volumen"

#: src/window.vala:593
msgid "Session D-Bus unavailable"
msgstr "D-Bus de sesión no disponible"

