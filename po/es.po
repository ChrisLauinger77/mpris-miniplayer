msgstr "Inicia cualquier reproductor compatible con MPRIS"

#: src/window.vala:608
msgid "Player unavailable"
msgstr "Reproductor no disponible"

#: src/window.vala:702
msgid "Shuffle: On"
msgstr "Aleatorio: activado"

#: src/window.vala:702
msgid "Shuffle: Off"
msgstr "Aleatorio: desactivado"

#: src/window.vala:721
msgid "Queue unavailable"
msgstr "Cola no disponible"

