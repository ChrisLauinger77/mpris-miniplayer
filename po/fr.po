msgstr "%s — %s"

#: src/application.vala:40
msgid "Control playback"
msgstr "Contrôler la lecture"

#: src/application.vala:47
msgid "Unexpected command-line arguments.\n"
msgstr "Arguments de ligne de commande inattendus.\n"

#: src/application.vala:55
#, c-format
msgid "Unknown playback action “%s”.\n"
msgstr "Action de lecture inconnue « %s ».\n"

#: src/application.vala:641
msgid "MPRIS MiniPlayer is running in the background"
msgstr "MPRIS MiniPlayer s’exécute en arrière-plan"

#: src/application.vala:643
msgid ""
"The window will appear automatically when a compatible media player becomes "
"available."
msgstr ""
"La fenêtre apparaîtra automatiquement lorsqu’un lecteur multimédia "
"compatible sera disponible."

#: src/application.vala:645
msgid "Open the window when you want to control a compatible media player."
msgstr ""
"Ouvrez la fenêtre lorsque vous souhaitez contrôler un lecteur multimédia "
"compatible."

#: src/application.vala:647
msgid "Open"
msgstr "Ouvrir"

#: src/preferences-window.vala:37
msgid "Behavior"
msgstr "Comportement"

#: src/preferences-window.vala:41
msgid "Show and hide automatically"
msgstr "Afficher et masquer automatiquement"

#: src/preferences-window.vala:42
msgid "Show the window when a player appears and hide it when none remain"
msgstr ""
"Afficher la fenêtre lorsqu’un lecteur apparaît et la masquer lorsqu’il n’en "
"reste aucun"

#: src/preferences-window.vala:50
msgid "Background notification"
msgstr "Notification en arrière-plan"

#: src/preferences-window.vala:51
msgid "Notify when the app starts hidden in the background"
msgstr "Notifier lorsque l’application démarre masquée en arrière-plan"

#: src/preferences-window.vala:59
msgid "Start on login"
msgstr "Démarrer à la connexion"

#: src/preferences-window.vala:60
msgid "Start MPRIS MiniPlayer automatically when you log in"
msgstr "Démarrer MPRIS MiniPlayer automatiquement à la connexion"

#: src/preferences-window.vala:70
msgid "Compact mode"
msgstr "Mode compact"

#: src/preferences-window.vala:71
msgid "Use a smaller window layout"
msgstr "Utiliser une disposition de fenêtre plus petite"

#: src/preferences-window.vala:79
msgid "Tint with album color"
msgstr "Teinter avec la couleur de l’album"

#: src/preferences-window.vala:80
msgid "Use a color from the current album cover"
msgstr "Utiliser une couleur de la pochette de l’album actuel"

#: src/preferences-window.vala:88
msgid "Keep player queue open"
msgstr "Garder la file d’attente du lecteur ouverte"

#: src/preferences-window.vala:89
msgid "Keep the queue in the player window open after selecting a track"
msgstr ""
"Garder la file d’attente ouverte dans la fenêtre du lecteur après la "
"sélection d’un morceau"

#: src/preferences-window.vala:97
msgid "Status indicator"
msgstr "Indicateur d’état"

#: src/preferences-window.vala:123
msgid "Show an indicator when the app is running"
msgstr "Afficher un indicateur lorsque l’application est en cours d’exécution"

#: src/preferences-window.vala:124
msgid "Not supported by this desktop"
msgstr "Non pris en charge par ce bureau"

#: src/window.vala:33
msgid "Currently playing"
msgstr "Lecture en cours"

#: src/window.vala:266
msgid "Choose player"
msgstr "Choisir un lecteur"

#: src/window.vala:278
msgid "Main menu"
msgstr "Menu principal"

#: src/window.vala:283
msgid "About MPRIS MiniPlayer"
msgstr "À propos de MPRIS MiniPlayer"

#: src/window.vala:322
msgid "No player running"
msgstr "Aucun lecteur en cours d’exécution"

#: src/window.vala:328
msgid "Start an MPRIS-compatible media player"
msgstr "Lancez un lecteur multimédia compatible MPRIS"

#: src/window.vala:346 src/window.vala:349
msgid "Playback position"
msgstr "Position de lecture"

#: src/window.vala:411 src/window.vala:412
