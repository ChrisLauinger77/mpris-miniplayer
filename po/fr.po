msgstr "Impossible de surveiller les lecteurs MPRIS"

#: src/window.vala:602
msgid "Start any MPRIS-compatible player"
msgstr "Lancez un lecteur compatible MPRIS"

#: src/window.vala:608
msgid "Player unavailable"
msgstr "Lecteur indisponible"

#: src/window.vala:702
msgid "Shuffle: On"
msgstr "Lecture aléatoire : activée"

#: src/window.vala:702
msgid "Shuffle: Off"
msgstr "Lecture aléatoire : désactivée"

#: src/window.vala:721
msgid "Queue unavailable"
msgstr "File d’attente indisponible"

